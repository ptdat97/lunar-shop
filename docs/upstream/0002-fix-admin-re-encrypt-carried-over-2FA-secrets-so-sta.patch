From 7be2b3447d76ac6460d5208f9f22c1c2db4c2f23 Mon Sep 17 00:00:00 2001
From: ptdat97 <ptdats2@gmail.com>
Date: Thu, 27 Aug 2026 14:12:12 +0700
Subject: [PATCH] fix(admin): re-encrypt carried over 2FA secrets so staff are
 not locked out
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`2025_06_20_100000_rename_two_factor_columns_on_staff_table` renames the columns
left by lunarphp/filament3-2fa but leaves the values untouched, and the two
implementations do not store them the same way:

  lunarphp/filament3-2fa   encrypt($secret)                payload WITH serialize
  Filament v4              cast 'encrypted'
                           -> decrypt($value, false)       payload WITHOUT serialize

Filament therefore reads a carried-over secret back as the literal string
`s:16:"JBSWY3DPEHPK3PXP";` instead of `JBSWY3DPEHPK3PXP`, and every staff member
who had 2FA enabled loses access to the panel after upgrading to 1.5. It does not
fail politely either: that wrapper is not valid base32, so Google2FA throws
`InvalidCharactersException` and `AppAuthentication::verifyCode()` does not catch
it — the MFA challenge 500s rather than reporting a wrong code.

Recovery codes break the same way. The old package stored
`encrypt(json_encode([...]))` while the new cast is `'encrypted:array'`, so
`json_decode()` lands on the serialized wrapper and yields `null`.

Add a follow-up migration that decrypts and re-encrypts in the format the cast
expects. Detection is by content rather than by a flag: only a value that
decrypts to a PHP-serialized string is rewritten, so it is safe to re-run and
safe on a table holding a mix of old and new rows — a base32 secret and a JSON
array can never look like a serialized payload. A value that cannot be decrypted
with the current APP_KEY is left in place rather than destroyed.
---
 ...rypt_two_factor_columns_on_staff_table.php |  91 ++++++++++++++
 .../Models/StaffTwoFactorMigrationTest.php    | 117 ++++++++++++++++++
 2 files changed, 208 insertions(+)
 create mode 100644 packages/admin/database/migrations/2025_06_20_100100_reencrypt_two_factor_columns_on_staff_table.php
 create mode 100644 tests/admin/Unit/Models/StaffTwoFactorMigrationTest.php

diff --git a/packages/admin/database/migrations/2025_06_20_100100_reencrypt_two_factor_columns_on_staff_table.php b/packages/admin/database/migrations/2025_06_20_100100_reencrypt_two_factor_columns_on_staff_table.php
new file mode 100644
index 0000000..f0f7f43
--- /dev/null
+++ b/packages/admin/database/migrations/2025_06_20_100100_reencrypt_two_factor_columns_on_staff_table.php
@@ -0,0 +1,91 @@
+<?php
+
+use Illuminate\Support\Facades\Crypt;
+use Illuminate\Support\Facades\DB;
+use Lunar\Base\Migration;
+
+/**
+ * Re-encrypt the staff 2FA columns carried over from lunarphp/filament3-2fa.
+ *
+ * The migration that runs just before this one renames the columns
+ * (two_factor_secret -> app_authentication_secret, two_factor_recovery_codes ->
+ * app_authentication_recovery_codes) but leaves the values untouched. The two
+ * implementations do not store them the same way:
+ *
+ *   lunarphp/filament3-2fa  encrypt($secret)              payload WITH serialize
+ *   Filament v4             cast 'encrypted' ->
+ *                           decrypt($value, false)        payload WITHOUT serialize
+ *
+ * So Filament reads a carried-over secret back as the literal string
+ * `s:16:"JBSWY3DPEHPK3PXP";` rather than `JBSWY3DPEHPK3PXP`, and every staff
+ * member who had 2FA enabled is locked out of the panel. It does not even fail
+ * politely: that wrapper is not valid base32, so Google2FA throws
+ * InvalidCharactersException and AppAuthentication::verifyCode() does not catch
+ * it — the MFA challenge 500s instead of reporting a wrong code.
+ *
+ * Recovery codes break the same way. The old package stored
+ * encrypt(json_encode([...])) while the new cast is 'encrypted:array', so
+ * json_decode() lands on the serialized wrapper and yields null.
+ *
+ * Detection is by content rather than by a flag: only a value that decrypts to a
+ * PHP-serialized string is rewritten. That makes this safe to re-run and safe on
+ * a table holding a mix of old and new rows — a base32 secret and a JSON array
+ * can never look like a serialized payload. A value that cannot be decrypted
+ * with the current APP_KEY is left alone rather than destroyed.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        $table = $this->prefix.'staff';
+
+        DB::table($table)
+            ->where(fn ($query) => $query
+                ->whereNotNull('app_authentication_secret')
+                ->orWhereNotNull('app_authentication_recovery_codes'))
+            ->orderBy('id')
+            ->chunkById(100, function ($rows) use ($table) {
+                foreach ($rows as $row) {
+                    $update = array_filter([
+                        'app_authentication_secret' => $this->reencrypt($row->app_authentication_secret),
+                        'app_authentication_recovery_codes' => $this->reencrypt($row->app_authentication_recovery_codes),
+                    ], fn ($value) => $value !== null);
+
+                    if ($update) {
+                        DB::table($table)->where('id', $row->id)->update($update);
+                    }
+                }
+            });
+    }
+
+    public function down(): void
+    {
+        // Deliberately irreversible. Restoring the serialized form would only
+        // re-break the panel, and the plaintext is identical either way, so
+        // nothing is lost by leaving the values in the format Filament reads.
+    }
+
+    /**
+     * Return the re-encrypted value, or null when the row needs no change.
+     */
+    private function reencrypt(?string $stored): ?string
+    {
+        if (blank($stored)) {
+            return null;
+        }
+
+        try {
+            $plain = Crypt::decryptString($stored);
+        } catch (Throwable) {
+            return null;
+        }
+
+        $unserialized = @unserialize($plain);
+
+        if (! is_string($unserialized)) {
+            return null; // already in the format Filament v4 expects
+        }
+
+        return Crypt::encryptString($unserialized);
+    }
+};
diff --git a/tests/admin/Unit/Models/StaffTwoFactorMigrationTest.php b/tests/admin/Unit/Models/StaffTwoFactorMigrationTest.php
new file mode 100644
index 0000000..32fe9b4
--- /dev/null
+++ b/tests/admin/Unit/Models/StaffTwoFactorMigrationTest.php
@@ -0,0 +1,117 @@
+<?php
+
+use Filament\Auth\MultiFactor\App\AppAuthentication;
+use Illuminate\Support\Facades\Crypt;
+use Illuminate\Support\Facades\DB;
+use Lunar\Admin\Models\Staff;
+use Lunar\Tests\Admin\Unit\Models\TestCase;
+use PragmaRX\Google2FA\Exceptions\InvalidCharactersException;
+use PragmaRX\Google2FAQRCode\Google2FA;
+
+uses(TestCase::class)
+    ->group('lunar.admin.models');
+
+const LEGACY_SECRET = 'JBSWY3DPEHPK3PXP';
+const LEGACY_RECOVERY = ['aaaa-bbbb', 'cccc-dddd'];
+
+function staffTable(): string
+{
+    return config('lunar.database.table_prefix').'staff';
+}
+
+/** Write the columns exactly the way lunarphp/filament3-2fa did. */
+function staffWithLegacyTwoFactor(): Staff
+{
+    $staff = Staff::factory()->create();
+
+    DB::table(staffTable())->where('id', $staff->id)->update([
+        'app_authentication_secret' => encrypt(LEGACY_SECRET),
+        'app_authentication_recovery_codes' => encrypt(json_encode(LEGACY_RECOVERY)),
+    ]);
+
+    return $staff->fresh();
+}
+
+function runReencryptionMigration(): void
+{
+    $migration = require __DIR__.'/../../../../packages/admin/database/migrations/2025_06_20_100100_reencrypt_two_factor_columns_on_staff_table.php';
+
+    $migration->up();
+}
+
+test('a carried over secret is unreadable before the migration', function () {
+    $staff = staffWithLegacyTwoFactor();
+
+    // The serialized wrapper comes back as the "secret".
+    expect($staff->getAppAuthenticationSecret())->toEqual('s:16:"'.LEGACY_SECRET.'";');
+    expect($staff->getAppAuthenticationRecoveryCodes())->toBeNull();
+});
+
+test('the migration makes the secret and recovery codes readable', function () {
+    $staff = staffWithLegacyTwoFactor();
+
+    runReencryptionMigration();
+
+    $staff = $staff->fresh();
+
+    expect($staff->getAppAuthenticationSecret())->toEqual(LEGACY_SECRET);
+    expect($staff->getAppAuthenticationRecoveryCodes())->toEqual(LEGACY_RECOVERY);
+});
+
+test('a code from the original authenticator app validates after the migration', function () {
+    $staff = staffWithLegacyTwoFactor();
+
+    runReencryptionMigration();
+
+    $code = app(Google2FA::class)->getCurrentOtp(LEGACY_SECRET);
+
+    expect(AppAuthentication::make()->verifyCode($code, $staff->fresh()->getAppAuthenticationSecret()))
+        ->toBeTrue();
+});
+
+test('without the migration the mfa challenge throws rather than rejecting the code', function () {
+    $staff = staffWithLegacyTwoFactor();
+
+    $code = app(Google2FA::class)->getCurrentOtp(LEGACY_SECRET);
+
+    AppAuthentication::make()->verifyCode($code, $staff->getAppAuthenticationSecret());
+})->throws(InvalidCharactersException::class);
+
+test('running the migration twice does not double wrap', function () {
+    $staff = staffWithLegacyTwoFactor();
+
+    runReencryptionMigration();
+    $afterFirst = DB::table(staffTable())->where('id', $staff->id)->value('app_authentication_secret');
+
+    runReencryptionMigration();
+    $afterSecond = DB::table(staffTable())->where('id', $staff->id)->value('app_authentication_secret');
+
+    expect($staff->fresh()->getAppAuthenticationSecret())->toEqual(LEGACY_SECRET);
+
+    // The ciphertext differs (random IV) but the plaintext must not.
+    expect(Crypt::decryptString($afterSecond))->toEqual(Crypt::decryptString($afterFirst));
+});
+
+test('staff without two factor are untouched', function () {
+    $staff = Staff::factory()->create();
+
+    runReencryptionMigration();
+
+    $row = DB::table(staffTable())->where('id', $staff->id)->first();
+
+    expect($row->app_authentication_secret)->toBeNull();
+    expect($row->app_authentication_recovery_codes)->toBeNull();
+});
+
+test('a value encrypted under another app key is left in place', function () {
+    $staff = Staff::factory()->create();
+    $foreign = base64_encode('not-a-laravel-payload');
+
+    DB::table(staffTable())->where('id', $staff->id)
+        ->update(['app_authentication_secret' => $foreign]);
+
+    runReencryptionMigration();
+
+    expect(DB::table(staffTable())->where('id', $staff->id)->value('app_authentication_secret'))
+        ->toEqual($foreign);
+});

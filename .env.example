APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:T+qyrmnH4ePVCWZATjyOUG39r2880HpVcqxRdpZsD60=
APP_DEBUG=true
APP_URL=http://lunar-shop.test

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lunar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
#QUEUE_CONNECTION=database

CACHE_STORE=redis
#CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MEDIA_DISK=media

THEME=fashion

SHIPPING_FREE_THRESHOLD=50000

# Lifetime of an API personal access token (mobile app / POS), in days. Stamped on
# the token as `expires_at` when issued; clients roll forward with
# POST /api/v1/auth/token/refresh. Set to 0 to issue non-expiring tokens.
# NOTE: do not set sanctum.expiration — it measures from `created_at` and would
# invalidate every token already in the wild.
API_TOKEN_TTL_DAYS=60

# ─── Theo dõi lỗi (Sentry) ───────────────────────────────────────────────────
# Bỏ trống = TẮT HẲN: SDK không gửi gì, không mở kết nối nào. Cố ý như vậy —
# bật một đường truyền dữ liệu ra bên thứ ba phải là quyết định có người bấm nút,
# không phải hệ quả phụ của việc cài package.
#
# Không có nó thì lỗi production chỉ nằm trong storage/logs: khách gặp 500 giữa
# lúc thanh toán và KHÔNG AI BIẾT. `shop:preflight` cảnh báo (không chặn) nếu
# production chạy mà chưa đặt.
SENTRY_LARAVEL_DSN=

# Tách lỗi máy dev khỏi lỗi production trên Sentry. Không đặt thì đổ chung một chỗ.
SENTRY_ENVIRONMENT="${APP_ENV}"

# Gắn bản deploy vào lỗi để biết commit nào gây ra. Trên server đặt trong quy
# trình deploy: SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=

# Lấy mẫu performance. Bỏ trống = tắt, và nên để tắt: free tier tính theo
# transaction, mà shop SME cần BÁO ĐỘNG LỖI chứ chưa cần hồ sơ hiệu năng.
SENTRY_TRACES_SAMPLE_RATE=

# ─── Header bảo mật ──────────────────────────────────────────────────────────
# CSP_MODE: report | enforce | off. Mặc định `report` — trình duyệt chỉ báo vi
# phạm, không chặn. Chạy vài ngày, đọc vi phạm thật, rồi mới đổi sang `enforce`.
# Panel LUÔN report-only bất kể giá trị này (bundle của Lunar, ta không kiểm soát).
CSP_MODE=report
# Nơi trình duyệt POST báo cáo vi phạm. Bỏ trống thì vi phạm chỉ hiện ở DevTools
# của người đang mở trang — đủ để soi tay, không đủ để biết khách gặp gì.
CSP_REPORT_URI=

# HSTS chỉ gửi ở production TRÊN HTTPS, bất kể cờ này. Gửi nhầm trên http sẽ
# khoá trình duyệt vào https cho cả domain trong max_age giây, và không rút lại
# được từ phía server.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Nộp domain vào danh sách preload của Chrome gần như một chiều — đừng bật cho
# tới khi https đã chạy ổn định.
HSTS_PRELOAD=false

# ─── Thanh toán ──────────────────────────────────────────────────────────────
# Bỏ trống = cổng đó KHÔNG được chào ở checkout (cả trang lẫn API). Shop chạy
# COD + chuyển khoản là hợp lệ, không phải cấu hình thiếu.
#
# ⚠️ URL mặc định dưới đây là SANDBOX. Khi lên production phải đổi sang endpoint
# thật, nếu không khách sẽ "thanh toán" bằng tiền test và tiền không bao giờ về.
# `php artisan shop:preflight` chặn phát hành nếu còn sót — chạy nó trong pipeline
# deploy, sau `migrate` và trước khi mở traffic.

# VNPay — tmn_code + hash_secret lấy ở cổng merchant VNPay.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Mặc định là APP_URL + /payment/vnpay/return, chỉ đặt khi cần khác đi.
VNPAY_RETURN_URL=

# MoMo — partner_code + access_key + secret_key lấy ở MoMo Business.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_URL=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_RETURN_URL=
MOMO_IPN_URL=

# Bắt buộc lớp thứ hai (TOTP hoặc mã email) khi nhân viên đăng nhập panel.
# Mặc định `false` cho cửa hàng đơn một tài khoản: mật khẩu đúng là vào thẳng.
# Đặt `true` nếu có nhiều nhân viên hoặc panel mở ra Internet công cộng.
# Xem config/staff.php để biết tắt đi thì mất gì và giữ được gì.
PANEL_REQUIRE_TWO_FACTOR=false

# Tài khoản đăng nhập /panel do seeder tạo — CHỈ chạy ở local/testing, seeder tự
# từ chối ở môi trường khác. Bỏ trống thì dùng admin@lunar-shop.test / password.
DEMO_STAFF_EMAIL=admin@lunar-shop.test
DEMO_STAFF_PASSWORD=password
